# Used by backend and worker for GitHub bundle import/sync/push.
# The web UI never collects this token.
GITHUB_PAT=replace-me

# Used for git commits created by optimization writeback.
GIT_COMMIT_NAME=DSPy Trainer
GIT_COMMIT_EMAIL=dspy-trainer@local

# Required to encrypt/decrypt stored secrets such as module environment entries
# and LM Profile provider API keys stored in Postgres.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSPY_TRAINER_MODULE_ENV_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Optional: number of MLflow web workers to run in docker-compose.
# Increase if trace and run UI/API requests time out under load.
MLFLOW_WEB_WORKERS=4

# Optional: number of general worker containers to run in docker-compose.
DSPY_TRAINER_TOTAL_WORKERS=8

# Optional: deployment-wide maximum number of concurrent bundle dependency installs.
DSPY_TRAINER_BUNDLE_INSTALL_MAX_CONCURRENCY=8

# Optional: number of dedicated endpoint worker containers to run in docker-compose.
# These workers self-register with the backend's durable endpoint-worker registry.
DSPY_TRAINER_TOTAL_ENDPOINT_WORKER_REPLICAS=72

# Optional: seconds before a missing endpoint-worker heartbeat is treated as stale.
DSPY_TRAINER_ENDPOINT_WORKER_HEARTBEAT_TTL_SECONDS=300
# Dedicated revision-image deployer timing. The advisory-lock session is treated
# unhealthy after the leader command timeout; active claims are renewed while builds run.
DSPY_TRAINER_DEPLOYER_LEADER_TIMEOUT_SECONDS=15
DSPY_TRAINER_DEPLOYER_CLAIM_TIMEOUT_SECONDS=300
DSPY_TRAINER_DEPLOYER_POLL_INTERVAL_SECONDS=1

# Managed endpoint reconciliation timing and local image retention. Timeouts are
# positive seconds; retention is per module and cannot be lower than two images.
DSPY_TRAINER_DEPLOYER_ENDPOINT_READINESS_TIMEOUT_SECONDS=120
DSPY_TRAINER_DEPLOYER_ENDPOINT_DRAIN_TIMEOUT_SECONDS=300
DSPY_TRAINER_DEPLOYER_ENDPOINT_RECONCILE_INTERVAL_SECONDS=2
DSPY_TRAINER_DEPLOYER_IMAGE_RETENTION_COUNT=2

# Durable log tail retained per image build (1..262144 bytes).
DSPY_TRAINER_DEPLOYER_BUILD_LOG_MAX_BYTES=262144

# Stable explicit local backend image name. The deployer inspects this name once,
# registers the immutable image ID, and passes only that ID to generated builds.
# Do not retag it while revision-image builds are queued or running.
DSPY_TRAINER_BACKEND_IMAGE=dspy-trainer-backend:local
DSPY_TRAINER_DEPLOYER_IMAGE_REPOSITORY=dspy-trainer-revision
DSPY_TRAINER_DEPLOYER_PLATFORM_VERSION=local

# Stable ownership boundaries. Use unique values for every Compose deployment.
COMPOSE_PROJECT_NAME=dspy-trainer
DSPY_TRAINER_COMPOSE_NETWORK_NAME=dspy-trainer
DSPY_TRAINER_COMPOSE_NETWORK_PROJECT_LABEL=dspy-trainer
DSPY_TRAINER_MANAGED_LABEL_NAMESPACE=io.dspy-trainer
DSPY_TRAINER_DEPLOYMENT_ID=dspy-trainer-local

# Optional: host port exposed by the local Caddy reverse proxy.
CADDY_HTTP_PORT=8080

# Keep empty for local Compose. MLflow serves internally at root so both its
# REST API and /v1/traces work; Caddy exposes the browser UI under /mlflow.
MLFLOW_STATIC_PREFIX=

# Browser origins allowed to call the MLflow UI API through Caddy.
MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional public Host header accepted by MLflow in remote deployments.
MLFLOW_ALLOWED_HOSTS_EXTRA=

# Public URLs baked into the web build. Relative defaults target the local Caddy proxy surface.
VITE_API_BASE_URL=/api
VITE_MLFLOW_BASE_URL=/mlflow

# Optional explicit CORS origins to allow in addition to the public URLs above.
DSPY_TRAINER_CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
